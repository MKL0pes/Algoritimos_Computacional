// Um posto está vendendo combustíveis com a seguinte tabela de descontos: Álcool: até 20 litros, desconto de 3% por litro acima de 20 litros, desconto de 5% por litro Gasolina: até 20 litros, desconto de 4% por litro acima de 20 litros, desconto de 6% por litro.
Escreva um programa C que leia o número de litros vendidos, o tipo de combustível (codificado da seguinte forma: A-álcool, G-gasolina), calcule e imprima o valor a ser pago pelo cliente sabendo-se que o preço do litro da gasolina é R$ 2,50 o preço do litro do álcool é R$ 1,90.

#include <stdio.h>

int main() {
  char tipo;
  float litros, preco_litro, desconto, valor_total;

  printf("Informe o tipo de combustivel (A para Alcool, G para Gasolina): ");
  scanf(" %c", &tipo); // O espaço antes de %c ignora quebras de linha pendentes no buffer

  printf("Informe a quantidade de litros vendidos: ");
  scanf("%f", &litros);

  if (tipo == 'A' || tipo == 'a') {
    preco_litro = 1.90;

    if (litros <= 20.0) {
      desconto = 0.03; // 3% de desconto
    } else {
      desconto = 0.05; // 5% de desconto
    }

  } 
  else if (tipo == 'G' || tipo == 'g') {
    preco_litro = 2.50;
    
    if (litros <= 20.0) {
      desconto = 0.04; // 4% de desconto
    } else {
     
       desconto = 0.06; // 6% de desconto

    }

  } 
  else {
    printf("\nTipo de combustivel invalido! Use A ou G.\n");
    return 1; // Encerra o programa com erro

  }

  valor_total = (preco_litro - (preco_litro * desconto)) * litros;

  printf("\n--- Resumo do Abastecimento ---\n");
  printf("Combustivel: %s\n", (tipo == 'A' || tipo == 'a') ? "Alcool" : "Gasolina");
  printf("Litros: %.2f\n", litros);
  printf("Valor a ser pago: R$ %.2f\n", valor_total);

  return 0;

}
